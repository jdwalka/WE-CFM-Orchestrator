{
  "name": "kalshi-ladder-worker",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat_v2"],
  "account_id": "f226035af09775dbffd7e6350adc8a12",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "ladder.leaksnipe.win",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["*/1 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "LADDER_CACHE",
      "id": "11089b487b4048729f3a49e6a302c3fb"
    }
  ],
  "d1_databases": [
    {
      "binding": "ladder",
      "database_id": "48536b22-03b3-42dd-92fa-44feab144d84",
      "database_name": "scalper-calibration"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
