# Dockerfile.edge
# Co-located Kalshi executor + DQN inference.
# Designed for a single us-east-1 VPS, not the brain.
#
# Build context is the repo root so we can reuse the existing package.json
# and src/ tree. We intentionally do NOT install devDependencies here.

FROM node:20-bullseye-slim

WORKDIR /app

# Native build tooling kept slim — only what kafkajs/ioredis need on glibc.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm install --omit=dev --no-audit --no-fund

COPY src/  ./src
COPY tools/ ./tools

# Unprivileged runtime user; matches the existing Dockerfile.node posture.
RUN groupadd --system appgroup && useradd --system --gid appgroup --home /app appuser \
 && mkdir -p /app/data /app/.cache \
 && chown -R appuser:appgroup /app
USER appuser

# No EXPOSE — the edge never accepts host traffic. All inter-service
# comms stay on the internal edge-net bridge.
CMD ["node", "src/kalshi/kalshi-shell-entry.js"]
