			"target": ["tag:trading"],
			"attr":   ["low-latency", "execution-plane", "no-cache-dns"],
		},
		{
			"target": ["tag:research"],
			"attr":   ["sandbox", "ephemeral", "untrusted"],
		},
		{
			"target": ["tag:sensitive"],
			"attr":   ["restricted", "admin-only"],
		},
		{
			"target": ["tag:mullvad"],
			"attr":   ["vpn-egress"],
		},
