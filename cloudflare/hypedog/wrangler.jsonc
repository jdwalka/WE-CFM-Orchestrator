{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hypedog",
  "main": "src/index.js",
  "compatibility_date": "2026-09-10",
  "d1_databases": [
    {
      "binding": "jdwalkaz",
      "database_name": "scalper-calibration",
      "database_id": "48536b22-03b3-42dd-92fa-44feab144d84"
    }
  ],
  "routes": [
    {
      "pattern": "trufflehype.leaksnipe.win",
      "custom_domain": true
    },
    {
      "pattern": "trufflehype.leaksnipe.win/*",
      "zone_name": "leaksnipe.win"
    }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
