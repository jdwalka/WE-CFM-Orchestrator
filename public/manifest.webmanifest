{
  "name": "ALPHA-1.1 · WE CFM Orchestrator",
  "short_name": "ALPHA-1.1",
  "description": "Live CFM benchmark orchestration and predictive UP/DOWN market engine. 7 coins · 5 polls per 3-min window · Kraken + Kalshi + Polymarket.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "minimal-ui"],
  "background_color": "#0b1020",
  "theme_color": "#0b1020",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "./pwa-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "./pwa-icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./pwa-icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "./pwa-icon.svg",
      "sizes": "1280x720",
      "type": "image/svg+xml",
      "form_factor": "wide"
    },
    {
      "src": "./pwa-icon.svg",
      "sizes": "720x1280",
      "type": "image/svg+xml"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+wecryp",
      "url": "./index.html?uri=%s"
    }
  ]
}
