{
  "name": "we-cfm-orchestrator",
  "version": "2.15.6",
  "private": true,
  "description": "WalkerEnterprise CFM Kalshi 15m Deep Dive Optimization — Divergence detection + real-time momentum + crash protection",
  "author": "WalkerEnterprise",
  "main": "electron/main.js",
  "scripts": {
    "scan:google-fragments": "node scripts/scan-google-fragments.js",
    "install:firebase-service-account": "node scripts/install-firebase-service-account.js",
    "security:scan-secrets": "node scripts/secret-scan.js",
    "security:scan-secrets:staged": "node scripts/secret-scan.js --staged",
    "cloud:precheck": "node -e \"const g=require('./src/cloud/google-cloud-bridge'); g.probeCloudSql({force:true}).then(r=>{console.log('[cloud-precheck]', JSON.stringify({configured:r.configured, success:r.success, cached:!!r.cached, state:r.instanceState||null, dbExists:r.databaseExists ?? null, error:r.error||null}, null, 2)); if(process.env.WECRYPTO_REQUIRE_CLOUD_READY==='1' && (!r.configured || !r.success)){process.exit(1);} }).catch(err=>{console.error('[cloud-precheck] fatal', err?.message||err); process.exit(1);});\"",
    "cloud:ensure-db": "node -e \"const g=require('./src/cloud/google-cloud-bridge'); g.ensureCloudSqlDatabase({force:true}).then(r=>{console.log('[cloud-ensure-db]', JSON.stringify(r,null,2)); if(!r.success){process.exit(1);} }).catch(err=>{console.error('[cloud-ensure-db] fatal', err?.message||err); process.exit(1);});\"",
    "firebase:precheck": "node scripts/firebase-precheck.js",
    "firebase:precheck:local": "node scripts/firebase-precheck.js --target=emulator",
    "firebase:emulator": "npx -y firebase-tools@latest emulators:start --only firestore --project wecrypto",
    "preflight:release": "npm run security:scan-secrets && npm run cloud:ensure-db && npm run cloud:precheck && npm run firebase:precheck",
    "start": "npm run start:dev",
    "start:dev": "electron .",
    "start:firestore-local": "node scripts/start-firestore-local.js",
    "start:prod": "npm run preflight:release && electron .",
    "build": "npm run build:local",
    "build:local": "node scripts/build-electron-safe.js win",
    "build:release": "npm run preflight:release && node scripts/build-electron-safe.js win",
    "build:portable": "node scripts/build-electron-safe.js portable",
    "build:portable:release": "npm run preflight:release && node scripts/build-electron-safe.js portable",
    "build:installer": "node scripts/build-electron-safe.js nsis",
    "build:installer:release": "npm run preflight:release && node scripts/build-electron-safe.js nsis",
    "build:artifact-plan": "node scripts/build-electron-safe.js portable --dry-run",
    "backtest:recalibrate": "node backtest/outcome-retuner.js --days 60 --coins BTC,ETH,SOL,XRP",
    "backtest:recalibrate:week": "node backtest/outcome-retuner.js --days 7 --coins BTC,ETH,SOL,XRP --write-weights",
    "backtest:advanced": "node backtest/advanced-backtest.js --days 30",
    "backtest:advanced:volatility": "node backtest/advanced-volatility-backtest.js --days 7",
    "backtest:walkforward": "node backtest/walk-forward-backtest.js --days 30 --fold-size 400 --test 100 --step 50",
    "backtest:kalshi-odds-wf": "node backtest/kalshi-odds-walkforward.js --days 7 --coins BTC,ETH,SOL,XRP --train 120 --test 40 --step 20 --min-trades 12",
    "backtest:pipeline": "node backtest/recalibrate-and-backtest.js --write-weights",
    "backtest:recalibrate:polymarket": "node backtest/polymarket-retuner.js",
    "backtest:adaptive": "node backtest/adaptive-backtest-harness.js --days 7 --coins BTC,ETH,SOL,XRP --compare-static --adaptive-mode",
    "backtest:hyper-sweep": "node src/core/run-hyper-sweep.js",
    "backtest:regime-analyze": "node backtest/adaptive-regime-weighter.js",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.walkerenterprise.wecfmorchestrator",
    "productName": "WE-CRYPTO-Kalshi-15m-v2.15.6",
    "electronVersion": "41.4.0",
    "asar": true,
    "files": [
      "public/**",
      "src/**",
      "electron/**",
      "assets/**",
      "settlement-retune.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "proxy/target/x86_64-pc-windows-gnu/release/we-crypto-proxy.exe",
        "to": "we-crypto-proxy.exe"
      }
    ],
    "asarUnpack": [
      "we-crypto-proxy.exe"
    ],
    "icon": "assets/app-icon.ico",
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WE--CRYPTO--BETA3",
      "artifactName": "WE-CRYPTO-Kalshi-15m-v2.15.6-installer-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "WE-CRYPTO-Kalshi-15m-v2.15.6-portable-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "assemblyscript": "^0.28.17",
    "electron": "^41.7.1",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@coinbase/coinbase-sdk": "^0.25.0",
    "@google/genai": "^1.52.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@polymarket/clob-client": "^5.8.1",
    "@polymarket/clob-client-v2": "^1.0.6",
    "@pythnetwork/pyth-lazer-sdk": "^6.2.2",
    "dotenv": "^17.4.2",
    "eventsource": "^4.1.0",
    "express": "^5.1.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^12.7.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "kalshi-typescript": "^3.20.0",
    "node-addon-api": "^8.7.0",
    "node-fetch": "^2.7.0",
    "openai": "^6.42.0",
    "selfsigned": "^5.5.0",
    "socks-proxy-agent": "^10.0.0",
    "telegram": "^2.26.22",
    "ws": "^8.20.1"
  },
  "bin": {
    "wecryp": "./wecryp-cli.js"
  }
}
