{
  "name": "we-cfm-orchestrator",
  "version": "2.15.6",
  "private": true,
  "license": "UNLICENSED",
  "author": "Mauro Fanelli Jr. / WalkerEnterprise",
  "main": "electron/main.js",
  "scripts": {
    "scan:google-fragments": "node scripts/scan-google-fragments.js",
    "install:firebase-service-account": "node scripts/install-firebase-service-account.js",
    "security:scan-secrets": "node scripts/secret-scan.js",
    "security:scan-secrets:staged": "node scripts/secret-scan.js --staged",
    "security:scan:local": "bash scripts/security-scan.sh",
    "cloud:precheck": "node -e \"const g=require('./src/cloud/google-cloud-bridge'); g.probeCloudSql({force:true}).then(r=>{console.log('[cloud-precheck]', JSON.stringify({configured:r.configured, success:r.success, cached:!!r.cached, state:r.instanceState||null, dbExists:r.databaseExists ?? null, error:r.error||null}, null, 2)); if(process.env.WECRYPTO_REQUIRE_CLOUD_READY==='1' && (!r.configured || !r.success)){process.exit(1);} }).catch(err=>{console.error('[cloud-precheck] fatal', err?.message||err); process.exit(1);});\"",
    "cloud:ensure-db": "node -e \"const g=require('./src/cloud/google-cloud-bridge'); g.ensureCloudSqlDatabase({force:true}).then(r=>{console.log('[cloud-ensure-db]', JSON.stringify(r,null,2)); if(!r.success){process.exit(1);} }).catch(err=>{console.error('[cloud-ensure-db] fatal', err?.message||err); process.exit(1);});\"",
    "firebase:precheck": "node scripts/firebase-precheck.js",
    "firebase:precheck:local": "node scripts/firebase-precheck.js --target=emulator",
    "firebase:emulator": "npx -y firebase-tools@latest emulators:start --only firestore --project wecrypto",
    "preflight:release": "npm run security:scan-secrets && npm run cloud:ensure-db && npm run cloud:precheck && npm run firebase:precheck",
    "start": "npm run start:dev",
    "start:server": "node scripts/start-runtime.js",
    "start:linux": "bash ./launch_dev.sh server",
    "start:linux:server": "bash ./launch_dev.sh server",
    "start:linux:electron": "bash ./launch_dev.sh electron",
    "start:linux:docker": "bash ./launch_dev.sh docker",
    "setup:linux": "bash ./scripts/setup-linux.sh all",
    "setup:linux:check": "bash ./scripts/setup-linux.sh check",
    "weights:extract": "node scripts/extract-weights.js",
    "weights:sync": "node scripts/sync-weights.js",
    "weights:update": "node scripts/extract-weights.js && node scripts/sync-weights.js",
    "build:quant": "node ./node_modules/typescript/bin/tsc src/quant/quant-layer.ts --target ES2022 --module none --ignoreConfig --ignoreDeprecations 6.0",
    "build:proxy:linux": "bash ./scripts/setup-linux.sh build-proxy",
    "start:dev": "npm run build:quant && electron .",
    "start:firestore-local": "node scripts/start-firestore-local.js",
    "start:prod": "npm run preflight:release && electron .",
    "build": "node scripts/build-dispatch.js",
    "build:web": "vite build",
    "build:electron": "node scripts/build-electron-safe.js win",
    "build:win": "node scripts/build-electron-safe.js win",
    "build:local": "node scripts/build-electron-safe.js win",
    "deploy:web": "npm run build:web && firebase deploy --only hosting --project wecrypto",
    "build:release": "npm run preflight:release && node scripts/build-electron-safe.js win",
    "build:portable": "node scripts/build-electron-safe.js portable",
    "build:portable:release": "npm run preflight:release && node scripts/build-electron-safe.js portable",
    "build:installer": "node scripts/build-electron-safe.js nsis",
    "build:installer:release": "npm run preflight:release && node scripts/build-electron-safe.js nsis",
    "build:artifact-plan": "node scripts/build-electron-safe.js portable --dry-run",
    "backtest:polymarket-ptb": "node backtest/polymarket-ptb-twap-backtest.js --coins BTC,ETH,SOL,XRP --interval 5m --days 7",
    "backtest:polymarket-ptb:15m": "node backtest/polymarket-ptb-twap-backtest.js --coins BTC,ETH,SOL,XRP --interval 15m --days 7",
    "retrain:polymarket-ptb": "node backtest/polymarket-ptb-retuner.js --days 7 --coins BTC,ETH,SOL,XRP",
    "retrain:polymarket-ptb:write": "node backtest/polymarket-ptb-retuner.js --days 7 --coins BTC,ETH,SOL,XRP --write-weights",
    "backtest:recalibrate": "node backtest/outcome-retuner.js --days 60 --coins BTC,ETH,SOL,XRP",
    "backtest:recalibrate:week": "node backtest/outcome-retuner.js --days 7 --coins BTC,ETH,SOL,XRP --write-weights",
    "backtest:advanced": "node backtest/advanced-backtest.js --days 30",
    "backtest:advanced:volatility": "node backtest/advanced-volatility-backtest.js --days 7",
    "backtest:walkforward": "node backtest/walk-forward-backtest.js --days 30 --fold-size 400 --test 100 --step 50",
    "backtest:pipeline": "node backtest/recalibrate-and-backtest.js --write-weights",
    "backtest:pipeline:11d": "node backtest/recalibrate-and-backtest.js --days 11 --write-weights --coins BTC,ETH,SOL,XRP",
    "backtest:edge-committee": "node backtest/edge-committee-retuner.js --days 11 --coins BTC,ETH,SOL,XRP",
    "backtest:edge-committee:write": "node backtest/edge-committee-retuner.js --days 11 --coins BTC,ETH,SOL,XRP --write-config",
    "backtest:rl-stack": "node backtest/rl-stack-trainer.js --days 11 --coins BTC,ETH,SOL,XRP --write-bundle",
    "backtest:rl-stack:week": "node backtest/rl-stack-trainer.js --days 7 --coins BTC,ETH,SOL,XRP --write-bundle",
    "backtest:tft-trainer": "node backtest/tft-trainer.js --days 11 --coins BTC,ETH,SOL,XRP --write-bundle",
    "backtest:tft-trainer:week": "node backtest/tft-trainer.js --days 7 --coins BTC,ETH,SOL,XRP --write-bundle",
    "backtest:recalibrate:polymarket": "node backtest/polymarket-retuner.js",
    "backtest:adaptive": "node backtest/adaptive-backtest-harness.js --days 7 --coins BTC,ETH,SOL,XRP --compare-static --adaptive-mode",
    "backtest:hyper-sweep": "node src/core/run-hyper-sweep.js",
    "backtest:regime-analyze": "node backtest/adaptive-regime-weighter.js",
    "backtest:llm-batch-submit": "node backtest/llm-batch-backtest.js submit --coins BTC,ETH,SOL,XRP --days 14 --horizons 15,60",
    "backtest:llm-batch-score": "node backtest/llm-batch-backtest.js score --latest --wait",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "ai:cli": "python3 scripts/universal_ai_cli.py",
    "ai:providers": "python3 scripts/universal_ai_cli.py --list-providers",
    "test:mergekit": "node --test tests/weight-mergekit.test.js",
    "test:resonance": "node tests/resonance-filter.test.js",
    "test:hud-perf": "node --test tests/hud-perf.test.js",
    "mergekit:tuner": "node scripts/mergekit_evolve_tuner.js",
    "mergekit:recipes": "node configs/mergekit/recipe_generator.js --list-templates"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.walkerenterprise.wecfmorchestrator",
    "productName": "WE-CRYPTO-Polymarket-v2.15.6",
    "electronVersion": "41.4.0",
    "asar": true,
    "files": [
      "public/**",
      "src/**",
      "electron/**",
      "assets/**",
      "scripts/**",
      "proxy.pac",
      "cloudflared/**",
      "settlement-retune.js",
      "docker-compose.yml",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "proxy/target/x86_64-pc-windows-gnu/release/we-crypto-proxy.exe",
        "to": "we-crypto-proxy.exe"
      },
      {
        "from": "docker-compose.yml",
        "to": "docker-compose.yml"
      }
    ],
    "asarUnpack": [
      "we-crypto-proxy.exe"
    ],
    "icon": "assets/app-icon.ico",
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "WE-CRYPTO-Polymarket",
      "runAfterFinish": true,
      "artifactName": "WE-CRYPTO-Polymarket-v2.15.6-installer-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "WE-CRYPTO-Polymarket-v2.15.6-portable-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.10.1",
    "@vitejs/plugin-react": "^5.2.0",
    "assemblyscript": "^0.28.17",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.3",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-manus-runtime": "^0.0.58",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@coinbase/coinbase-sdk": "^0.25.0",
    "@google/genai": "^1.52.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@polymarket/clob-client": "^5.8.1",
    "@polymarket/clob-client-v2": "^1.0.6",
    "@pythnetwork/pyth-lazer-sdk": "^6.2.2",
    "@radix-ui/react-accordion": "^1.2.13",
    "@radix-ui/react-alert-dialog": "^1.1.16",
    "@radix-ui/react-aspect-ratio": "^1.1.9",
    "@radix-ui/react-avatar": "^1.1.12",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-collapsible": "^1.1.13",
    "@radix-ui/react-context-menu": "^2.3.0",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-hover-card": "^1.1.16",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-menubar": "^1.1.17",
    "@radix-ui/react-navigation-menu": "^1.2.15",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-progress": "^1.1.9",
    "@radix-ui/react-radio-group": "^1.4.0",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slider": "^1.4.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-toggle": "^1.1.11",
    "@radix-ui/react-toggle-group": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@types/express": "^5.0.6",
    "@types/google.maps": "^3.65.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "eventsource": "^4.1.0",
    "express": "^5.1.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^12.7.0",
    "input-otp": "^1.4.2",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "kalshi-typescript": "^3.20.0",
    "lucide-react": "^1.18.0",
    "next-themes": "^0.4.6",
    "node-addon-api": "^8.7.0",
    "node-fetch": "^2.7.0",
    "openai": "^6.42.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.79.0",
    "react-resizable-panels": "^4.11.2",
    "recharts": "^3.8.1",
    "selfsigned": "^5.5.0",
    "socks": "^2.8.9",
    "socks-proxy-agent": "^10.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "telegram": "^2.26.22",
    "vaul": "^1.1.2",
    "wouter": "^3.10.0",
    "ws": "^8.21.0"
  },
  "overrides": {
    "ws": "$ws",
    "form-data@2": "2.5.6",
    "form-data@4": "4.0.6",
    "undici": "6.28.0",
    "tar": "7.5.22",
    "js-yaml": "4.3.1",
    "protobufjs": "7.6.5",
    "uuid": "11.1.1"
  },
  "bin": {
    "wecryp": "./wecryp-cli.js"
  }
}
