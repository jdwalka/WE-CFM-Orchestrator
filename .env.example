# .env.example — Copy to .env and update values
# This file shows all available environment variables

# ========================================
# Bybit API — HTTP 451 Geo-blocking Bypass
# ========================================
# Enable proxy routing to bypass US IP blocking
BYBIT_USE_PROXY=true

# Proxy server URL (CORS Anywhere is public, consider using your own for production)
BYBIT_PROXY_URL=https://cors-anywhere.herokuapp.com

# To use a different proxy:
# BYBIT_PROXY_URL=https://your-custom-proxy-server.com

# ========================================
# Google Cloud / Firebase / Vertex AI (optional)
# ========================================
# Reuse your private .env for real values — keep this file placeholder-only.
# NOTE: Browser/client values MUST use VITE_ prefix and belong in client/.env.local
# (see client/.env.example). Keep backend credentials non-VITE here or in secrets/.

# Optional: override where secret key files are loaded from
# Default is ./secrets relative to workspace root
WECRYPTO_SECRETS_DIR=./secrets

# GCP project
WECRYPTO_GOOGLE_PROJECT_ID=your-project-id
WECRYPTO_GOOGLE_PROJECT_NUMBER=your-project-number
WECRYPTO_GOOGLE_QUOTA_PROJECT=your-project-id

# Auth options (pick one)
# 1) Recommended local desktop path: rely on an already-authenticated gcloud CLI
# 2) Or provide a service account JSON path / JSON blob
# WECRYPTO_GOOGLE_SERVICE_ACCOUNT_PATH=C:\path\to\service-account.json
# WECRYPTO_GOOGLE_SERVICE_ACCOUNT_JSON={...json...}

# Pub/Sub event fan-out for web state + LLM + TiDE shadow requests
WECRYPTO_PUBSUB_ENABLED=false
WECRYPTO_PUBSUB_TOPIC=wecrypto-shadow-events

# Firebase Realtime Database mirror for remote dashboards / Cloud Functions
WECRYPTO_FIREBASE_ENABLED=false
WECRYPTO_FIREBASE_REQUIRED=false
# Firestore mode:
# - auto: use prod first, then fall back to the local emulator when optional prod writes time out
# - prod: prod only
# - emulator: local emulator only
WECRYPTO_FIRESTORE_MODE=auto
WECRYPTO_FIRESTORE_LOCAL_FALLBACK=true
WECRYPTO_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
WECRYPTO_FIRESTORE_WRITE_TIMEOUT_MS=6500
WECRYPTO_FIRESTORE_OPERATION_TIMEOUT_MS=6500
WECRYPTO_FIRESTORE_WRITE_ATTEMPTS=2
WECRYPTO_FIRESTORE_BACKOFF_BASE_MS=350
WECRYPTO_FIRESTORE_CIRCUIT_BASE_MS=30000
WECRYPTO_FIRESTORE_TICKS_ENABLED=false
# Optional Firebase App Hosting / Hosting URL (for your provisioned app endpoint)
WECRYPTO_FIREBASE_APP_URL=https://your-app.firebase.app
WECRYPTO_FIREBASE_RTDB_URL=https://your-project-default-rtdb.firebaseio.com
WECRYPTO_FIREBASE_STATE_PATH=/wecrypto/state
WECRYPTO_FIREBASE_LLM_PATH=/wecrypto/llm
WECRYPTO_FIREBASE_TIDE_PATH=/wecrypto/tide

# ========================================
# Firebase AI Logic — Gemini signal narration
# ========================================
# Set WECRYPTO_FIREBASE_AI_ENABLED=true (or LLM_PROVIDER=firebase) to activate.
# API key comes from Firebase console → Project Settings → Your apps → Web app.
# Store in your private .env — never commit the real key.
WECRYPTO_FIREBASE_AI_ENABLED=false
WECRYPTO_FIREBASE_API_KEY=your-firebase-web-api-key
WECRYPTO_FIREBASE_AUTH_DOMAIN=wecrypto.firebaseapp.com
WECRYPTO_FIREBASE_PROJECT_ID=wecrypto
WECRYPTO_FIREBASE_STORAGE_BUCKET=wecrypto.firebasestorage.app
WECRYPTO_FIREBASE_SENDER_ID=your-sender-id
WECRYPTO_FIREBASE_APP_ID=your-app-id
WECRYPTO_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
# Model to use (default: gemini-2.5-flash-latest)
WECRYPTO_FIREBASE_AI_MODEL=gemini-2.5-flash-latest
# Minimum ms between Gemini calls per coin (default: 30000 = one per 30s cycle)
WECRYPTO_FIREBASE_AI_INTERVAL_MS=30000

# Vertex AI TiDE shadow forecast bridge
WECRYPTO_VERTEX_TIDE_ENABLED=false
WECRYPTO_VERTEX_LOCATION=us-central1
WECRYPTO_TIDE_ENDPOINT_ID=

# ========================================
# Pyth Lazer live feed tuning
# ========================================
# Keep channel on a supported fixed rate and add slight timeout tolerance.
# Pyth Lazer streaming token (secrets/PYTH_NEW_API.txt is preferred)
PYTH_NEW_API=
# Optional full channel override (e.g., fixed_rate@1000ms or real_time)
# PYTH_LAZER_CHANNEL=fixed_rate@1000ms
PYTH_LIVE_FEED_BACKOFF_MS=5

# Coinbase Advanced Trade auth.
# Prefer an ECDSA key JSON in secrets/cdp_api_key-WECRYPTO-ECDSA.json.
# Optional pre-minted short-lived JWT fallback:
COINBASE_JWT=

# ========================================
# Redpanda / Kafka Streaming Pipeline
# ========================================
# Broker address(es), comma-separated.
# Default is localhost:9092 (matches the docker-compose single-node setup).
# Change only if you run Redpanda on a different host or port.
KAFKA_BROKERS=localhost:9092

# Set to 'false' to disable the orbital Redpanda pipeline entirely.
# When disabled, the app runs without streaming (Firebase-only mode).
ORBITAL_REDPANDA_ENABLED=true

# Kalshi worker base URL used by the f-orbital sentiment feed.
# The worker is spawned automatically by Electron on port 3050.
# Override only if you run the worker on a different port.
KALSHI_WORKER_URL=http://localhost:3050

# How often (ms) the f-orbital Kalshi sentiment poll runs.
# Default: 30000 (30 seconds). Minimum recommended: 10000.
KALSHI_ORBITAL_POLL_INTERVAL_MS=30000

# ========================================
# ASI:One LLM (primary inference + Agentverse)
# ========================================
# Official key name from docs.asi1.ai — never commit real values.
ASI_ONE_API_KEY=
# Alias also accepted (LeakSnipe pattern):
# ASI1_API_KEY=
# Secondary fallback when primary is rate-limited or exhausted:
# asi1_api_key2_fallback=
# ASI1_API_KEY2_FALLBACK=
# ASI1_BASE_URL=https://api.asi1.ai/v1
# ASI1_MODEL=asi1
# ASI1_HEALTH_MODEL=asi1-mini
# LLM_PROVIDER=auto
# When tokenmix.ai returns 402 / out of credits, the ASI1 credit orchestrator
# skips TokenMix and walks asi1-ultra → asi1-fast → asi1-mini → asi1.
# LLM_DISABLE_ASI1=0
# ASI1_PRECONTRACT_MODEL=asi1-ultra
# ASI1_5M_MODEL=asi1-fast

# Tailscale API (WARP coexist). Never commit the key.
# TAILSCALE_API_KEY=
# TAILSCALE_TAILNET=prairiedog-godzilla.ts.net

# ========================================
# xAI Grok — SuperGrok vs Console (separate products)
# ========================================
# SuperGrok (grok.com / X subscription) ≠ API credits.
# WECRYPTO + Grok Build need a key from https://console.x.ai/ (pay-per-token).
# Put key in secrets/XAI_API_KEY.txt OR XAI_API_KEY= below.
#
# Models (2026-08): grok-4.5 flagship · grok-4.3 cheaper high-volume · batch API for backtests
# XAI_API_KEY=
# GROK_API_KEY=
# XAI_MODEL=grok-4.5
# XAI_MODEL_FAST=grok-4.3
# XAI_PRIMARY_ALL=true
# XAI_BASE_URL=https://api.x.ai/v1/chat/completions
# XAI_MAX_TOKENS=2000
# XAI_BATCH_MODEL=grok-4.5
#
# LLM_PROVIDER=xai
# Legacy fallback if no XAI key:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8


COMPOSE_PROJECT_NAME=wecryp
