# Copy to .env and fill in before running mcp_agent.py.

# Agentverse mailbox registration (see register_agent.py at the repo root
# for the one-time registration step against this same seed phrase).
AGENTVERSE_KEY=
AGENT_SEED_PHRASE=
AGENT_NAME=hourly-range-scalper
AGENT_PORT=8001

# ASI:One — single account only (mauro@leaksnipe.win), matching this repo's
# in-progress consolidation off the legacy multi-account key rotation.
ASI1_API_KEY=
ASI1_MODEL=asi1-mini

# Decision cycle
SCALPER_INTERVAL_SECONDS=30
SCALPER_CONFIDENCE_THRESHOLD=0.55

# Execution layer hard limits — brain.py's size_hint is advisory only.
# MAX_POSITION_USD=0 means no live orders are placed yet.
MAX_CONCURRENT_POSITIONS=1
MAX_POSITION_USD=0
